# Copie este arquivo para ".env" e ajuste os valores.
# O ".env" é lido pelo Docker Compose e pela aplicação, e nunca vai para o Git.

# Origem: PostgreSQL
DB_ORIGEM_URL=jdbc:postgresql://localhost:5433/origem
DB_ORIGEM_USER=origem_user
DB_ORIGEM_PASSWORD=troque-esta-senha

# Destino: MongoDB (use senha sem caracteres especiais ou codifique-os no padrão de URL)
DB_DESTINO_HOST=localhost:27017
DB_DESTINO_USER=destino_user
DB_DESTINO_PASSWORD=troque-esta-senha
